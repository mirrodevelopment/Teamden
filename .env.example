# ==========================================
# Teamden by shed — Environment Configuration
# ==========================================
# Copy this file to .env or configure your system environment variables.
# Do NOT commit actual production passwords or secrets to Git.

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/teamden
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Server Configuration
SERVER_PORT=8080

# Initial Provisioning (Optional: Can also be provisioned via one-time Setup API)
SETUP_ORG_NAME="Acme Services Ltd"
SETUP_ADMIN_NAME="Admin User"
SETUP_ADMIN_EMAIL=admin@example.com
SETUP_ADMIN_PASSWORD=your_secure_password_here
